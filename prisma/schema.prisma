generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used by migrations
}

enum Role {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  FACULTY
  MENTOR
  STUDENT
  PARENT
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}

enum TestType {
  PRACTICE
  MOCK
}

enum TestStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ExamMode {
  CBT
  OMR
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMERICAL
  ASSERTION_REASON
  MATCH_THE_FOLLOWING
  PASSAGE
  IMAGE_BASED
}

enum AttemptStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  AUTO_SUBMITTED // Due to violation or time out
}

model Organization {
  id                  String         @id @default(cuid())
  name                String
  slug                String         @unique
  logoUrl             String?
  primaryColor        String?        @default("#3b82f6")
  secondaryColor      String?        @default("#1e40af")
  contactEmail        String?
  contactPhone        String?
  academicYear        String?        @default("2026-2027")
  customDomain        String?        @unique
  joinCode            String?        @unique // students and parents sign up with this code or the /join/<code> link
  whatsappConfig      String? // JSON configuration for notification provider
  offeredCategories   String? // JSON Array of strings (e.g. '["AFCAT", "GATE"]')
  examCentreEnabled   Boolean        @default(false) // opt-in: seat plans, start codes and the invigilator console
  offlineExamsEnabled Boolean        @default(false) // opt-in: papers pre-downloaded to devices, answers uploaded after
  users               User[]
  batches             Batch[]
  tests               Test[]
  questions           Question[]
  examTemplates       ExamTemplate[]
  announcements       Announcement[]
  resources           Resource[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String
  phone              String?
  studentCode        String? // the institute's own student / roll ID (upper-case); unique within the institute
  role               Role                @default(STUDENT)
  status             Status              @default(PENDING)
  organizationId     String?
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId            String?
  batch              Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attempts           Attempt[]
  requests           TestRequest[]
  sessionId          String?
  examTracks         String? // JSON array of exam categories the student is preparing for
  targetExamDate     DateTime? // student's exam day, drives the dashboard countdown
  dailyGoal          Int                 @default(30) // questions per day
  notifyWhatsapp     Boolean             @default(true) // opt-out of WhatsApp messages
  notifySms          Boolean             @default(true) // opt-out of SMS messages
  passwordResets     PasswordReset[]
  bookmarks          Bookmark[]
  reviewItems        ReviewItem[]
  studyLogs          StudyLog[]
  questionReports    QuestionReport[]
  announcements      Announcement[]
  resources          Resource[]
  examSeats          ExamSeat[]
  pendingSubmissions PendingSubmission[]

  // Parent - Student Linkage
  parentLinks  ParentStudentLink[] @relation("ParentLink")
  studentLinks ParentStudentLink[] @relation("StudentLink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, studentCode])
  @@index([organizationId, role])
  @@index([batchId])
  @@index([studentCode])
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  parent    User     @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentLink", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Batch {
  id             String        @id @default(cuid())
  name           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  tests          Test[]        @relation("BatchTests")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
}

model ExamTemplate {
  id                 String        @id @default(cuid())
  name               String // e.g. "JEE Main CBT 2026", "NEET OMR Practice", "AFCAT Standard"
  examCategory       String // e.g. "JEE", "NEET", "GATE", "AFCAT", "SSC", "CUSTOM"
  mode               ExamMode      @default(CBT)
  totalDuration      Int // total duration in minutes
  isSectionalTiming  Boolean       @default(false)
  hasNegativeMarking Boolean       @default(true)
  config             String // JSON configuration (sections, marking, cutoffs, proctoring rules, navigation)
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests              Test[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organizationId])
}

model Question {
  id             String           @id @default(cuid())
  text           String // Rich text or markdown
  options        String // JSON string of Array of { id, text }
  correctOption  String // ID or answer string
  explanation    String?
  subject        String
  chapter        String?
  topic          String
  subtopic       String?
  difficulty     String           @default("MEDIUM") // EASY, MEDIUM, HARD
  questionType   QuestionType     @default(SINGLE_CHOICE)
  marks          Float            @default(1.0)
  negativeMarks  Float            @default(0.0)
  tags           String // Comma-separated string
  estimatedTime  Int              @default(60) // in seconds
  examCategory   String?
  year           Int?
  language       String           @default("en")
  sourceFile     String? // Name of the source file
  status         String           @default("PUBLISHED") // DRAFT, PUBLISHED
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests          TestQuestion[]
  answers        Answer[]
  bookmarks      Bookmark[]
  reviewItems    ReviewItem[]
  reports        QuestionReport[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, subject, topic])
  @@index([examCategory])
}

model Test {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  duration           Int // in minutes
  totalMarks         Int
  type               TestType            @default(PRACTICE)
  mode               ExamMode            @default(CBT)
  status             TestStatus          @default(DRAFT)
  isPublished        Boolean             @default(false)
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  templateId         String?
  template           ExamTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  ownerId            String? // set for a student's private custom quiz; hidden from every listing
  // Anti-copying: OFF, PER_STUDENT (every student gets their own order) or SETS (setCount named sets A, B, C...)
  shuffleMode        String              @default("OFF")
  shuffleOptions     Boolean             @default(true) // also shuffle the options inside each question
  setCount           Int                 @default(4)
  // Exam Centre mode (only when the institute turned it on)
  centreExam         Boolean             @default(false) // students need the invigilator's start code to begin
  startCode          String? // staff-only until the invigilator announces it; also unlocks offline papers
  allowOffline       Boolean             @default(false) // devices may pre-download the encrypted paper and sit it offline
  centreRooms        String? // JSON [{ name, rows, cols }]
  seats              ExamSeat[]
  pendingSubmissions PendingSubmission[]
  organizationId     String?
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches            Batch[]             @relation("BatchTests")
  questions          TestQuestion[]
  attempts           Attempt[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([organizationId, isPublished])
  @@index([ownerId])
  @@index([templateId])
}

model TestQuestion {
  id         String   @id @default(cuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int // To allow explicit ordering
  section    String? // Optional section grouping (e.g. Physics, General Awareness)

  @@unique([testId, questionId])
  @@index([questionId])
}

model Attempt {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId           String
  test             Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  mode             ExamMode      @default(CBT)
  status           AttemptStatus @default(IN_PROGRESS)
  score            Float?
  percentage       Float?
  accuracy         Float?
  attemptedCount   Int?          @default(0)
  correctCount     Int?          @default(0)
  incorrectCount   Int?          @default(0)
  unattemptedCount Int?          @default(0)
  rank             Int?
  percentile       Float?
  subjectScores    String? // JSON string
  chapterScores    String? // JSON string
  topicScores      String? // JSON string
  weakTopics       String? // JSON string list of weak topics
  strongTopics     String? // JSON string list of strong topics
  startTime        DateTime      @default(now())
  endTime          DateTime?
  timeRemaining    Int // Seconds left
  answers          Answer[]
  violations       Violation[]
  mentorComment    String?
  isRetry          Boolean       @default(false)
  paperSeed        String? // drives this attempt's question/option order; null = original order
  setCode          String? // "A", "B"... when the test uses named sets
  deviceId         String? // random ID the exam device generated, shown to invigilators
  lastSeenAt       DateTime? // last autosave, for the invigilator's live view
  offline          Boolean       @default(false) // sat offline and uploaded afterwards
  parentAttemptId  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
  @@index([testId, status, score])
  @@index([userId, testId])
}

model Answer {
  id          String   @id @default(cuid())
  attemptId   String
  attempt     Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOpt String? // Option ID or submitted answer value
  isCorrect   Boolean?
  timeSpent   Int      @default(0) // Seconds spent on this question
  status      String   @default("UNANSWERED") // SAVED, MARKED_FOR_REVIEW, UNANSWERED
  subject     String?
  chapter     String?
  topic       String?
  updatedAt   DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Violation {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String // TAB_SWITCH, BLUR, COPY_PASTE, FULLSCREEN_EXIT
  timestamp DateTime @default(now())

  @@index([attemptId])
}

model TestRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count        Int // 3-5
  category     TestType @default(PRACTICE)
  examCategory String?
  notes        String?
  status       Status   @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
}

model NotificationLog {
  id                String   @id @default(cuid())
  recipientPhone    String
  recipientName     String?
  recipientUserId   String? // the user it was meant for, when known
  type              String // RESULT_NOTIFICATION, TEST_ASSIGNED, WEEKLY_REPORT, PASSWORD_RESET, TEST_MESSAGE
  channel           String   @default("WHATSAPP") // WHATSAPP, SMS
  provider          String? // META, TWILIO, MSG91
  status            String // SENT, FAILED, SKIPPED
  error             String? // why it failed or was skipped
  providerMessageId String?
  attempts          Int      @default(1)
  payload           String // JSON: message text and template variables (lets a failed message be retried)
  reportUrl         String?
  organizationId    String? // tenant that sent it; logs are only visible to that institute
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([organizationId, createdAt])
  @@index([recipientUserId])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([questionId])
}

model Announcement {
  id             String        @id @default(cuid())
  title          String
  body           String
  audience       String        @default("ALL") // ALL, STUDENTS, PARENTS
  priority       String        @default("NORMAL") // NORMAL, HIGH
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([authorId])
}

model Resource {
  id             String        @id @default(cuid())
  title          String
  url            String
  category       String        @default("Notes") // Notes, Formula Sheets, Previous Papers, Videos, Syllabus
  subject        String?
  description    String?
  authorId       String
  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([authorId])
}

// Spaced-repetition card: a question the student got wrong, scheduled for review (SM-2 style).
model ReviewItem {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  ease           Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, questionId])
  @@index([userId, dueAt])
  @@index([questionId])
}

// One row per student per day: questions answered in tests plus review cards, for goals and streaks.
model StudyLog {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD (UTC)
  questions Int    @default(0)
  reviews   Int    @default(0)

  @@unique([userId, day])
}

// A student flags a question as wrong or unclear; faculty resolve it from the question bank.
model QuestionReport {
  id             String    @id @default(cuid())
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason         String // WRONG_ANSWER, TYPO, UNCLEAR, OUTDATED, OTHER
  details        String?
  status         String    @default("OPEN") // OPEN, RESOLVED, DISMISSED
  resolution     String?
  organizationId String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([organizationId, status])
  @@index([questionId])
  @@index([userId])
}

// One-time code for resetting a password, delivered by WhatsApp/SMS. Only the hash is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Short, SMS-friendly link to a student's report card (/r/<code>). Tracks whether it was opened.
model ReportLink {
  code           String    @id // 8 random url-safe characters
  attemptId      String
  studentId      String
  organizationId String?
  clicks         Int       @default(0)
  lastOpenedAt   DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([attemptId])
  @@index([studentId])
}

// Fixed-window request counter used to throttle login, sign-up and password-reset attempts.
model RateLimit {
  key     String   @id // e.g. "login:email:asha@apex.in" or "register:ip:203.0.113.7"
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

// Who did what, for accountability and DPDP/compliance questions. Written by staff and admin actions.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  actorName      String?
  actorRole      String?
  action         String // e.g. "user.delete", "test.publish", "organization.update"
  targetType     String? // e.g. "User", "Test"
  targetId       String?
  summary        String? // human-readable one-liner shown in the log
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
}

// A student's seat for one Exam Centre test. Neighbouring seats get different sets.
model ExamSeat {
  id           String    @id @default(cuid())
  testId       String
  test         Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  room         String
  row          Int // 0-based
  col          Int // 0-based
  setIndex     Int
  downloadedAt DateTime? // when this student's device last downloaded the offline paper

  @@unique([testId, userId])
  @@unique([testId, room, row, col])
  @@index([userId])
}

// An offline answer sheet. DRAFT = a checkpoint the device sends while the exam runs (lets the
// invigilator see progress and lets a student resume on another computer); PENDING = submitted
// and waiting to be graded; then PROCESSING, DONE or FAILED. One row per student per test, so
// re-uploads are harmless.
model PendingSubmission {
  id               String    @id @default(cuid())
  testId           String
  test             Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload          String // JSON: ticket, start/submit times, answers
  status           String    @default("PENDING") // DRAFT, PENDING, PROCESSING, DONE, FAILED
  answeredCount    Int       @default(0)
  updatedAt        DateTime  @default(now())
  // Server-side timing evidence (the device clock can't be trusted for offline exams)
  firstSeenAt      DateTime  @default(now()) // first checkpoint or upload, by the server's clock
  lastCheckpointAt DateTime? // last checkpoint before the final sheet
  onTimePayload    String? // the last checkpoint that arrived within the time limit
  error            String?
  attemptId        String?
  receivedAt       DateTime  @default(now())
  claimedAt        DateTime?
  processedAt      DateTime?

  @@unique([testId, userId])
  @@index([status, receivedAt])
  @@index([userId])
}
